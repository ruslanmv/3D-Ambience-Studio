{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourfriend.online/schemas/ambience/environment-v1.schema.json",
  "title": "3D Ambience Environment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "category", "preview", "variants", "lighting", "effects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {"type": "string", "enum": ["relax", "meditation", "study", "sleep", "nature", "cozy", "fantasy", "focus", "chill", "seasonal"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "preview": {
      "type": "object", "additionalProperties": false, "required": ["src"],
      "properties": {"src": {"type": "string"}}
    },
    "orientation": {
      "type": "object", "additionalProperties": false,
      "properties": {"yawDegrees": {"type": "number", "minimum": -360, "maximum": 360}, "floorY": {"type": "number"}}
    },
    "variants": {
      "type": "object", "additionalProperties": false, "required": ["desktop", "quest", "companion"],
      "properties": {
        "desktop": {"$ref": "#/$defs/panoramaVariant"},
        "quest": {"$ref": "#/$defs/panoramaVariant"},
        "mobile": {"$ref": "#/$defs/panoramaVariant"},
        "companion": {"$ref": "#/$defs/companionVariant"}
      }
    },
    "audio": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["ambient", "loop", "defaultVolume"],
      "properties": {
        "ambient": {"type": "string"}, "loop": {"type": "boolean"},
        "defaultVolume": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "lighting": {
      "type": "object", "additionalProperties": false, "required": ["preset"],
      "properties": {"preset": {"type": "string"}, "exposure": {"type": "number", "minimum": 0, "maximum": 4}, "keyIntensity": {"type": "number", "minimum": 0, "maximum": 4}}
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "preset", "intensity"],
        "properties": {
          "type": {"type": "string", "enum": ["rain", "snow", "fireflies", "dust", "stars", "fog", "water-shimmer"]},
          "preset": {"type": "string"}, "intensity": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "geometry": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["src", "role"],
        "properties": {"src": {"type": "string"}, "role": {"type": "string", "enum": ["foreground", "diorama", "prop"]}}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {"minRuntime": {"type": "string"}, "passthrough": {"type": "string", "enum": ["hidden", "props-only", "compatible"]}}
    }
  },
  "$defs": {
    "panoramaVariant": {
      "type": "object", "additionalProperties": false, "required": ["type", "background"],
      "properties": {
        "type": {"const": "panorama"}, "background": {"type": "string"},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "companionVariant": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["inherit", "none", "transparent", "gradient", "panorama", "minimal"]},
        "preset": {"type": "string"}, "background": {"type": "string"}
      }
    }
  }
}
