{
  "schemaVersion": 1,
  "id": "sunset-beach",
  "version": "1.0.0",
  "name": "Sunset Beach",
  "description": "A calm tropical beach at sunset.",
  "category": "relax",
  "tags": [
    "beach",
    "ocean",
    "sunset",
    "meditation"
  ],
  "preview": {
    "src": "panorama-preview.webp"
  },
  "orientation": {
    "yawDegrees": 0,
    "floorY": 0
