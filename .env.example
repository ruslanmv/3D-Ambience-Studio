# Copy to .env and fill in. .env is gitignored; this file must stay empty of real values.

# Where projects, work files and published packages are written.
AMBIENCE_DATA_DIR=./data

# OpenAI image generation (the `plate --provider openai` route).
# The key is read from the environment only — never from a manifest, a project file or the
# settings store, and it is never written into provenance.json.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high

# Hugging Face Inference Providers (the default when the Studio runs as a Space).
# Needs the fine-grained permission "Make calls to Inference Providers".
HF_TOKEN=
